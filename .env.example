# Optional. Without a key, Truth Learning uses local hash embeddings and grounded extractive answers.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini

PORT=8080
TRUTH_DB_PATH=./data/truth-learning.db
TRUTH_UPLOAD_DIR=./uploads
TRUTH_PUBLIC_DIR=./public

# Optional OpenAI-compatible gateway. Defaults to https://api.openai.com
# OPENAI_BASE_URL=https://api.openai.com

